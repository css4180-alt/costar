# CoStar 백엔드 설정 예시. 이 파일을 .env로 복사하고 값을 채우세요.
# 실제 값(.env)은 절대 커밋하지 마세요.

# AWS 리전 (Rekognition, DynamoDB, S3 모두 같은 리전 권장)
AWS_REGION=ap-northeast-2

# AWS 자격증명은 여기서 관리하지 않습니다.
# - 로컬: ~/.aws/credentials 의 프로파일 사용 (aws configure)
# - Lambda: 실행 역할(IAM Role)이 자동으로 제공

# Rekognition
REKOGNITION_COLLECTION_ID=costar-persons
FACE_MATCH_THRESHOLD=90
DETECT_MIN_CONFIDENCE=80

# DynamoDB
DDB_TABLE=costar

# S3 (원본 이미지 저장 버킷)
S3_BUCKET=costar-media-<your-suffix>
PRESIGN_TTL_SECONDS=600

# 접근 제어 / 쿼터
# 형식: "패스코드:계정라벨,패스코드:계정라벨"
# 비워두면 인증/쿼터 비활성(로컬 개발용)
ACCESS_CODES=
AUTH_SECRET=change-me-to-a-random-string
DAILY_FACES_PER_ACCOUNT=500
SITE_DAILY_FACES_LIMIT=3000
TOKEN_TTL_HOURS=24
